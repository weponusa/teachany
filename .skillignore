# TeachAny Skill 打包排除清单
# 这些目录/文件体积大、对 skill 运行时非必需，安装 skill 时跳过

# 大体积课件库（用户应从源仓库单独访问）
community/
examples/

# 开发调试产物
screenshots/
test-hero-*.png
*.backup_*
*.OBSOLETE*.bak
SKILL_CN.md.OBSOLETE-*.bak

# Git 元数据（skill 安装不需要）
.git/
.github/

# Node/Python 临时文件
node_modules/
__pycache__/
*.pyc
.DS_Store

# 输出与缓存
output/
gallery/
*.log
